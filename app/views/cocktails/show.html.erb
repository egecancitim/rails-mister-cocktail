<section class="container detail-page">
  <div class="detail-header">
    <%= link_to "Back to all cocktails", root_path, class: "inline-link" %>
    <h1><%= @cocktail.name %></h1>
    <p>Build your recipe and keep ingredient measurements in one place.</p>
  </div>

  <div class="detail-grid">
    <article class="panel">
      <h2>Recipe</h2>
      <% if @cocktail.doses.any? %>
        <ul class="dose-list">
          <% @cocktail.doses.each do |dose| %>
            <li class="dose-item">
              <div>
                <h3><%= dose.ingredient.name %></h3>
                <p><%= dose.description %></p>
              </div>
              <%= link_to "Remove", dose_path(dose), method: :delete, data: { confirm: "Remove this ingredient from the recipe?" }, class: "text-button text-button-danger" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="empty-state">No ingredients yet. Add your first one from the form.</p>
      <% end %>
    </article>

    <aside class="panel">
      <%= render "doses/new", cocktail: @cocktail, dose: @dose %>
    </aside>
  </div>
</section>
