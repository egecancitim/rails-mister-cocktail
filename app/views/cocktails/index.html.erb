<section class="hero">
  <div class="container hero-inner">
    <p class="hero-kicker">Craft better drinks</p>
    <h1>Discover your next favorite cocktail</h1>
    <p class="hero-copy">
      Clean recipes, simple ingredient tracking, and faster prep for your home bar.
    </p>
    <div class="hero-actions">
      <%= link_to "Create a cocktail", new_cocktail_path, class: "btn btn-primary" %>
      <a class="btn btn-ghost" href="#cocktail-list">Browse recipes</a>
    </div>
  </div>
</section>

<section class="container cocktails-section" id="cocktail-list">
  <div class="section-header">
    <h2>All cocktails</h2>
    <span class="pill"><%= pluralize(@cocktails.count, "recipe") %></span>
  </div>

  <div class="cocktail-grid">
    <% @cocktails.each do |cocktail| %>
      <% image_url = cocktail.photo.attached? ? url_for(cocktail.photo) : "https://images.unsplash.com/photo-1572590016064-3e6ae9c04947?auto=format&fit=crop&w=900&q=80" %>
      <%= link_to cocktail_path(cocktail), class: "cocktail-card", style: "--card-image: linear-gradient(180deg, rgba(7, 16, 29, 0.05), rgba(7, 16, 29, 0.8)), url('#{image_url}');" do %>
        <span class="cocktail-card-title"><%= cocktail.name %></span>
        <span class="cocktail-card-link">View recipe</span>
      <% end %>
    <% end %>
  </div>
</section>
